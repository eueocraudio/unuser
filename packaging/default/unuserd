# Configuração do daemon unuserd (lido pela unit systemd como EnvironmentFile).
# Edite e rode: systemctl restart unuserd

# Diretório onde o cofre PERSISTE os arquivos (blobs cifrados + manifesto). O postinst
# cria/dá posse a este caminho na instalação.
# ATENÇÃO: se apontar para FORA de /var/lib/unuser, a unit (ProtectSystem=strict) o monta
# read-only. Libere com um drop-in:
#   systemctl edit unuserd   →   [Service]
#                                 ReadWritePaths=/seu/novo/caminho
UNUSERD_STORAGE=/var/lib/unuser/vault

# Diretório dos BACKUPS (export/import disparados pelo cliente). Aponte para a MÍDIA
# SECUNDÁRIA onde os .tar do cofre devem ficar. Se vazio, usa <storage>/backups.
# ATENÇÃO: como o storage, um caminho FORA de /var/lib/unuser exige liberar a escrita:
#   systemctl edit unuserd   →   [Service]
#                                 ReadWritePaths=/mnt/midia-secundaria/unuser-backups
# Monte a mídia antes do serviço subir (RequiresMountsFor=… no mesmo drop-in).
#UNUSERD_BACKUPS=/mnt/midia-secundaria/unuser-backups

# Escuta SÓ em localhost — o Onion Service do Tor publica o serviço (ver operacao-tor.md).
#
# mTLS (opcional): o par do servidor JÁ é gerado na instalação em
#   /etc/unuser/server.crt + /etc/unuser/server.key  (fingerprint impresso no postinst).
# Para EXIGIR cert de cliente, registre os certs confiáveis na allowlist:
#   cat cliente.crt >> /etc/unuser/allow.pem     # um por dispositivo confiável
# e acrescente a UNUSERD_ARGS (uma allowlist VAZIA recusaria todos os clientes):
#   --tls-cert /etc/unuser/server.crt --tls-key /etc/unuser/server.key --tls-allow /etc/unuser/allow.pem
UNUSERD_ARGS=--host 127.0.0.1 --port 8080
